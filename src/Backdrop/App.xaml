<!--
  App.xaml — WPF application definition. First thing the framework reads.
  No StartupUri: the wallpaper windows are built by hand in SceneHost once we
  know the monitor count and mode.

  x:Class            ties this markup to the App class in App.xaml.cs (same partial class)
  ShutdownMode       OnExplicitShutdown = don't quit when the last window closes; only
                     Application.Shutdown() ends the process (tray Quit, or a boot error).
-->
<Application x:Class="Backdrop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown" />
