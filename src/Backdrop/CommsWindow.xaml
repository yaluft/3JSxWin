<!--
  CommsWindow.xaml — markup for the "Comms log" panel: a small chromeless window
  hosting its OWN WebView2 (comms.html). The wallpaper layer sits behind every
  other window and can never take input, so the interactive uplink UI lives here
  in a normal top-level window. Code-behind: CommsWindow.xaml.cs.

  Attribute-by-attribute notes (XAML forbids comments inside a start tag, so they
  live here instead):

    wv2 namespace   the WebView2 WPF control, same assembly the scene windows use.
    Title           shows on the taskbar button and in Alt-Tab.
    Width/Height    opening size — but note MinWidth/MinHeight below are LARGER
                    (400 x 400 vs 380 x 520-ish width), so the window snaps up to
                    the minimum the moment it loads. Adjust both if you resize it.
    WindowStyle     None = no title bar, no system border; we draw the frame in
                    HTML. This also kills the taskbar button, which we force back
                    on from OnSourceInitialized (WS_EX_APPWINDOW).
    ResizeMode      CanResizeWithGrip = keep a bottom-right resize grip even with
                    no chrome, so the panel stays resizable.
    ShowInTaskbar   want our own taskbar entry (see WindowStyle note above).

    AllowsTransparency  — deliberately False (FIX; was True since commit 1397b90).
                    True made this a WPF layered window, which pushed compositing
                    to software and — the real damage — broke the airspace/focus
                    boundary with the WebView2 child HWND: clicks activated the
                    WPF frame but keyboard focus never reached the page, so the
                    input box ignored typing, and the caption-drag round-trip
                    lost mouse capture. An opaque window composites in hardware,
                    forwards input like ConsoleWindow (which never had the bug),
                    and lets the page paint its own dark shell. The see-through
                    corners of the 1397b90 look are gone; over this app's own
                    near-black wallpaper nobody can tell.

    Background    the void colour — what shows for the first frames before the
                    WebView2 paints (paired with DefaultBackgroundColor in the
                    code-behind).

    Topmost         float above the scene and normal apps; the uplink is always
                    reachable.
    ShowActivated   take focus when it opens.
    UseLayoutRounding + SnapsToDevicePixels  snap rendering to whole device
                    pixels so the thin HTML border and text stay crisp on
                    high-DPI screens instead of blurring across a pixel boundary.
    WindowStartupLocation  Manual — we place the window ourselves in OnLoaded
                    (bottom-left of the work area), so WPF must not auto-place it.
    MinWidth/MinHeight  floor size; see the Width/Height note about the snap.
-->
<Window x:Class="Backdrop.CommsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Comms log"
        Width="380" Height="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        AllowsTransparency="False"
        Background="#05070F"
        Topmost="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        MinWidth="400" MinHeight="400">
    <Grid>
        <!-- Single child: the WebView2 fills the whole window. All actual UI (log,
             input box, frame) is rendered by comms.html. Named "Web" so
             InitializeComponent() hands the code-behind a field to call
             EnsureCoreWebView2Async / Navigate on. -->
        <wv2:WebView2 x:Name="Web" />
    </Grid>
</Window>
